class Solution {
public:
    int maxSubarrayLength(vector<int>& nums, int k) {
        unordered_map<int, int> mp;
        int i = 0, j = 0;
        int mexi = 0;
        int n = nums.size();
        while (j < n) {
            mp[nums[j]]++;
            while (i < n && mp[nums[j]] > k) {
                mp[nums[i]]--;
                i++;
            }
            mexi = max(j - i+ 1, mexi);
            j++;
        }
        return mexi;
    }
};
