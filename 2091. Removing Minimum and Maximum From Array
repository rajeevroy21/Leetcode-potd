class Solution {
public:
    int minimumDeletions(vector<int>& nums) {
        int n = nums.size();
        int minIndex = 0;
        int maxIndex = 0;
        for (int i = 0; i < n; i++) {
            if (nums[i] < nums[minIndex]) {
                minIndex = i;
            }
            if (nums[i] > nums[maxIndex]) {
                maxIndex = i;
            }
        }
        int a = min(minIndex, maxIndex);
        int b = max(minIndex, maxIndex);
        int from_front  = b + 1;
        int from_back = n - a;
        int from_both = (a + 1 )+( n - b);
        return min({from_front , from_back, from_both});
    }
};
