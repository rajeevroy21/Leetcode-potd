class Solution {
public:
    int maximumLengthSubstring(string s) {
        unordered_map<char, int> mp;
        int l = 0, r = 0, n = s.size();
        int mexi = 0;
        for (; r < n; r++) {
            mp[s[r]]++;
            while (mp[s[r]] > 2) {
                mp[s[l]]--;
                l++;
            }
            mexi = max(mexi, r - l + 1);
        }
        return mexi;
    }
};
