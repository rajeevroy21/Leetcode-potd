class Solution {
public:
    int firstStableIndex(vector<int>& nums, int k) {
        int n = nums.size();
        vector<int> right_max(n), left_min(n);
        right_max[0] = nums[0];
        left_min[n - 1] = nums[n - 1];
        int ans = INT_MAX;
        for (int i = 1; i < n; i++) {
            right_max[i] = max(nums[i], right_max[i - 1]);
        }
        for (int i = n - 2; i >= 0; i--) {
            left_min[i] = min(nums[i], left_min[i + 1]);
        }
        for (int i = 0; i < n; i++) {
            ans = right_max[i] - left_min[i];
            if (ans <= k) {
                return i;
            }
        }
        return -1;
    }
};
