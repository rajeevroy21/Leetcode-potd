class Solution {
public:
    vector<int> nodesBetweenCriticalPoints(ListNode* head) {
        vector<int> ind;

        ListNode* curr = head->next;
        int i = 2;

        while (curr && curr->next) {
            if (curr->val > head->val && curr->val > curr->next->val) {
                ind.push_back(i);
            } else if (curr->val < head->val && curr->val < curr->next->val) {
                ind.push_back(i);
            }

            head = curr;
            curr = curr->next;
            i++;
        }
        if (ind.size() < 2) {
            return {-1, -1};
        }
        int maxi = ind.back() - ind.front();
        int mini = INT_MAX;
        for (int i = 1; i < ind.size(); i++) {
            mini = min(mini, ind[i] - ind[i - 1]);
        }
        return {mini, maxi};
    }
};
